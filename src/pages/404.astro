---
/**
 * The site is a single page, so there is nowhere to send someone except back
 * to it. No link list: there is only one destination.
 */
import AcademicLayout from '../layouts/AcademicLayout.astro';
import { loadContent } from '../lib/content.js';
import { url } from '../lib/url.js';

const { profile } = loadContent();
---

<AcademicLayout title="Page not found" description="That page does not exist on this site." noindex>
  <section class="section">
    <h1>That page does not exist</h1>
    <hr class="rule" />
    <p class="section-lead">
      The link may be out of date. Everything about {profile.name} is on
      <a href={url('/')}>the home page</a>.
    </p>
  </section>
</AcademicLayout>
