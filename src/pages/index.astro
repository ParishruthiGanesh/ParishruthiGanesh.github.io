---
/**
 * The single-page academic site.
 *
 * This is the whole site. There are no detail pages: every entry links
 * straight out to the paper, the repository or the demo, which is where the
 * real material lives anyway. The only other route is /cv, the printable CV.
 *
 * All assembly happens here in the frontmatter, because the template body is
 * compiled as JSX and cannot carry TypeScript type predicates.
 */
import AcademicLayout from '../layouts/AcademicLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import type { EntryLink } from '../components/EntryRow.astro';
import ProfileIcons from '../components/ProfileIcons.astro';
import { loadContent } from '../lib/content.js';
import { url } from '../lib/url.js';
import {
  CURRENT_WORK_LABELS,
  formatDate,
  formatMonth,
  formatRange,
  mdInline,
  STATUS_LABELS,
  splitEmail,
} from '../lib/format.js';
import type { Project, Hackathon, Publication } from '../lib/schema.js';

const content = loadContent();
const {
  profile,
  publications,
  projects,
  hackathons,
  experience,
  education,
  research,
  talks,
  awards,
  currentWork,
} = content;

const hackathonByProject = new Map<string, Hackathon>();
for (const hackathon of hackathons) {
  for (const id of hackathon.relatedProjects) hackathonByProject.set(id, hackathon);
}
const areaLabels = Object.fromEntries(research.map((theme) => [theme.id, theme.shortTitle]));

/** Schematic thumbnails generated for entries that have no figure of their own. */
const THUMBS = new Set(
  Object.keys(import.meta.glob('/public/images/thumbs/*.svg')).map((file) =>
    file.replace('/public/images/thumbs/', '').replace('.svg', ''),
  ),
);

/** A real screenshot where one exists, otherwise a schematic thumbnail. */
function thumbFor(project: Project | undefined, ...ids: string[]): string | undefined {
  const shot = project?.screenshots[0]?.src;
  if (shot) return shot;
  const match = ids.find((id) => THUMBS.has(id));
  return match ? `/images/thumbs/${match}.svg` : undefined;
}

/**
 * Terse venue line, in the form this format expects — "arXiv'26 · Submitted to
 * AAAI". Any longer caveat on the record (that an arXiv posting is not peer
 * review, for instance) belongs on the publication's own page, where there is
 * room to state it properly, rather than as three red lines in a list.
 */
function venueLine(pub: Publication): string {
  const where = `${pub.venueShort ?? pub.venue ?? ''}'${String(pub.year).slice(2)}`.trim();
  const submitted = pub.statusNote?.match(/submitted to ([A-Za-z][A-Za-z0-9 ]*?)(?:[.,;]|$)/i);
  const status = submitted ? `Submitted to ${submitted[1].trim()}` : (STATUS_LABELS[pub.status] ?? pub.status);
  return where ? `${where} · ${status}` : status;
}

const link = (label: string, href: string | undefined, unverified = false): EntryLink | null =>
  href ? { label, href, unverified } : null;

const keep = (items: Array<EntryLink | null>): EntryLink[] =>
  items.filter((item): item is EntryLink => item !== null);

/* ---------------- Research list ---------------- */

interface Row {
  key: string;
  title: string;
  titleHref?: string;
  authors?: string[];
  venue?: string;
  blurb?: string;
  links: EntryLink[];
  tags: string[];
  image: string;
  imageAlt: string;
}

const paperRows: Row[] = publications.map((pub) => {
  const project = projects.find((entry) => entry.relatedPublications.includes(pub.id));
  const mapped = content.researchLinks.filter((entry) => entry.paper === pub.id);
  return {
    key: `pub-${pub.id}`,
    title: pub.title,
    titleHref: pub.paperUrl,
    authors: pub.authors,
    venue: venueLine(pub),
    links: keep([
      link('Paper', pub.paperUrl),
      link('Arxiv', pub.arxivId ? `https://arxiv.org/abs/${pub.arxivId}` : undefined),
      ...mapped.map((entry) => link('Code', `https://github.com/${entry.repository}`)),
      link('Dataset', pub.datasetUrl),
      link('Video', pub.videoUrl),
    ]),
    tags: pub.researchAreas.map((area) => areaLabels[area] ?? area),
    image: thumbFor(project, project?.id ?? '', pub.id),
    imageAlt: '',
  };
});

/* Everything that is not a paper, in the curated order already set in
   projects.yml. A project already represented by a paper above is not
   repeated. */
const projectRows: Row[] = projects
  .filter((project) => project.relatedPublications.length === 0)
  .map((project) => {
    const hackathon = hackathonByProject.get(project.id);
    const repoPrivate = content.repositories.find(
      (repo) => repo.fullName === project.repository,
    )?.isPrivate;

    const venue = hackathon
      ? `${hackathon.hackathon}${hackathon.dateLabel ? ` · ${hackathon.dateLabel}` : ''}`
      : (project.period ?? (project.year ? String(project.year) : undefined));

    const links = keep([
      project.links.paper ? { label: 'Paper', href: project.links.paper.url } : null,
      project.links.repo
        ? repoPrivate
          ? { label: 'Code (private)', href: project.links.repo.url, disabled: true }
          : { label: 'Code', href: project.links.repo.url, unverified: !project.links.repo.verified }
        : null,
      project.links.demo
        ? { label: 'Demo', href: project.links.demo.url, unverified: !project.links.demo.verified }
        : null,
      project.links.devpost
        ? { label: 'Devpost', href: project.links.devpost.url, unverified: !project.links.devpost.verified }
        : null,
      project.links.video
        ? { label: 'Video', href: project.links.video.url, unverified: !project.links.video.verified }
        : null,
    ]);

    return {
      key: `project-${project.id}`,
      title: project.name,
      /* A private repository is not a destination — sending the title there
         gives a visitor a GitHub 404. Fall through to something they can open. */
      titleHref:
        (repoPrivate ? undefined : project.links.repo?.url) ??
        project.links.demo?.url ??
        project.links.devpost?.url ??
        project.links.video?.url,
      venue,
      blurb: project.tagline,
      links,
      tags: [
        ...project.researchAreas.map((area) => areaLabels[area] ?? area),
        ...project.technologies.slice(0, 3),
      ],
      image: thumbFor(project, project.id),
      imageAlt: project.screenshots[0]?.alt ?? '',
    };
  });

/* Papers under Research; everything else under Projects. */

/* ---------------- Currently ---------------- */

const currentRows = [...currentWork.items]
  .sort((a, b) => a.order - b.order)
  .map((item) => ({
    ...item,
    label: CURRENT_WORK_LABELS[item.status] ?? item.status,
    sinceLabel: formatMonth(item.since),
    href: publications.find((pub) => pub.id === item.relatedPublications[0])?.paperUrl,
  }));

/* ---------------- Experience ---------------- */

const roles = experience
  .filter((entry) => entry.type !== 'leadership')
  .map((entry) => ({ entry, highlights: entry.workstreams.map((stream) => stream.name) }));

/* ---------------- Miscellaneous ---------------- */

const serviceItems = [
  ...experience
    .filter((entry) => entry.type === 'leadership')
    .map((entry) => `${entry.role}, ${entry.organization} (${formatRange(entry.start, entry.end)})`),
  ...talks.map(
    (talk) => `${talk.type === 'poster' ? 'Poster' : 'Talk'}, ${talk.event} (${talk.date.slice(0, 4)})`,
  ),
  ...awards.map((award) => `${award.title}, ${award.organization} (${award.date.slice(0, 4)})`),
];

const educationRows = education.map((entry) => ({
  degree: entry.degree,
  institution: entry.institution,
  institutionUrl: entry.institutionUrl,
  detail: `(${formatRange(entry.start, entry.end)}${entry.grade ? `, ${entry.grade}` : ''})`,
}));

const { user, domain } = splitEmail(profile.email);
const year = new Date().getFullYear();

const schema = publications.map((pub) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: pub.title,
  name: pub.title,
  author: pub.authors.map((name) => ({ '@type': 'Person', name })),
  datePublished: String(pub.year),
  ...(pub.abstract ? { abstract: pub.abstract } : {}),
  ...(pub.paperUrl ? { url: pub.paperUrl } : {}),
  creativeWorkStatus: STATUS_LABELS[pub.status],
}));
---

<AcademicLayout schema={schema}>
  {/* ---------------- Masthead ---------------- */}
  <header class="masthead">
    <div>
      <h1>{profile.name}</h1>

      {/* Inline markdown so a link in the content file still renders here. */}
      {profile.intro.map((paragraph) => (<p class="bio" set:html={mdInline(paragraph)} />))}

      <p class="status-line">Open to research collaborations and research internships</p>

      <p class="contact-line">
        <a href={`mailto:${user}@${domain}`}>{user}<span aria-hidden="true">@</span>{domain}</a>
        {' · '}
        {profile.location}
      </p>

      <ProfileIcons />
    </div>

    {
      profile.avatar && (
        <img
          class="portrait"
          src={url(profile.avatar)}
          alt={`Portrait of ${profile.name}`}
          width="500"
          height="500"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
  </header>

  {/* ---------------- Currently ---------------- */}
  {
    currentRows.length > 0 && (
      <section class="section" aria-labelledby="current-heading">
        <h2 id="current-heading">Currently</h2>
        <hr class="rule" />

        <ul class="current-list">
          {currentRows.map((item) => (
            <li>
              <p class="current-head">
                <span class="current-status">{item.label}</span>
                <span class="current-since">since {item.sinceLabel}</span>
              </p>
              <p class="current-title">{item.href ? <a href={url(item.href)}>{item.title}</a> : item.title}</p>
              <p class="current-blurb">{item.description}</p>
            </li>
          ))}
        </ul>

        <p class="current-updated">Last updated {formatDate(currentWork.updated)}.</p>
      </section>
    )
  }

  {/* ---------------- Research ---------------- */}
  <section class="section" aria-labelledby="research-heading">
    <h2 id="research-heading">Research</h2>
    <hr class="rule" />

    <p class="section-lead" set:html={mdInline(profile.researchLead)} />

    <ul class="entries">
      {
        paperRows.map((row, index) => (
          <EntryRow
            title={row.title}
            titleHref={row.titleHref}
            authors={row.authors}
            self={profile.name}
            venue={row.venue}
            blurb={row.blurb}
            links={row.links}
            tags={row.tags}
            image={row.image}
            imageAlt={row.imageAlt}
            eager={index === 0}
          />
        ))
      }
    </ul>
  </section>

  {/* ---------------- Projects ---------------- */}
  <section class="section" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <hr class="rule" />

    <ul class="entries">
      {
        projectRows.map((row) => (
          <EntryRow
            title={row.title}
            titleHref={row.titleHref}
            venue={row.venue}
            blurb={row.blurb}
            links={row.links}
            tags={row.tags}
            image={row.image}
            imageAlt={row.imageAlt}
          />
        ))
      }
    </ul>
  </section>

  {/* ---------------- Experience ---------------- */}
  <section class="section" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>
    <hr class="rule" />

    <ol class="timeline">
      {
        roles.map(({ entry, highlights }) => (
          <li class="timeline-row">
            <div class="timeline-when">{formatRange(entry.start, entry.end)}</div>
            <div>
              <p class="timeline-role">{entry.role}</p>
              <p class="timeline-org">
                {entry.organizationUrl ? (
                  <a href={entry.organizationUrl} rel="noopener">
                    {entry.organization}
                  </a>
                ) : (
                  entry.organization
                )}
              </p>
              {entry.location && <p class="timeline-where">{entry.location}</p>}
              {highlights.length > 0 && (
                <ul class="timeline-detail">
                  {highlights.map((name) => (
                    <li>{name}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ---------------- Miscellaneous ---------------- */}
  <section class="section" aria-labelledby="misc-heading">
    <h2 id="misc-heading">Miscellaneous</h2>
    <hr class="rule" />

    <div class="misc-row">
      <div class="misc-label">Education</div>
      <ul class="misc-body">
        {
          educationRows.map((row) => (
            <li>{row.degree}, {row.institutionUrl ? <a href={row.institutionUrl} rel="noopener">{row.institution}</a> : row.institution} {row.detail}</li>
          ))
        }
      </ul>
    </div>

    {
      serviceItems.length > 0 && (
        <div class="misc-row">
          <div class="misc-label">Service</div>
          <ul class="misc-body">
            {serviceItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="misc-row">
      <div class="misc-label">
        Open to
        <span class="misc-note">Happy to hear from you by email.</span>
      </div>
      <ul class="misc-body">
        {profile.openTo.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  {/* ---------------- Footer ---------------- */}
  <footer class="page-footer" slot="footer">
    <ul class="footer-links">
      <li><a href={url('/cv')}>CV</a></li>
      <li><a href={url(profile.resume.path)} download={profile.resume.filename}>CV (PDF)</a></li>
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      {profile.links.github && <li><a href={profile.links.github} rel="me noopener">GitHub</a></li>}
      {profile.links.googleScholar && <li><a href={profile.links.googleScholar} rel="me noopener">Google Scholar</a></li>}
    </ul>
    <p>
      © {year} {profile.name}. Built with Astro; the page is generated from validated content
      files.
    </p>
  </footer>
</AcademicLayout>
