---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  class?: string;
}
const { eyebrow, title, lead, class: className = '' } = Astro.props;
---
<header class:list={['border-b py-14 sm:py-20', className]} style="border-color: var(--border)">
  <div class="container-page">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-3 text-3xl font-semibold sm:text-4xl lg:text-[2.75rem]" style="color: var(--ink)">
      {title}
    </h1>
    {
      lead && (
        <p class="mt-5 max-w-3xl text-lg leading-relaxed" style="color: var(--ink-muted)">
          {lead}
        </p>
      )
    }
    <slot />
  </div>
</header>
