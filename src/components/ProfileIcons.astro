---
/**
 * The icon row under the masthead. Only renders an icon when the underlying
 * link is actually configured, so there are never dead placeholders.
 */
import { loadContent } from '../lib/content.js';
import { url } from '../lib/url.js';

const { profile } = loadContent();

type Icon = { label: string; href: string; path: string; fill?: boolean; external?: boolean };

const icons: Icon[] = [
  {
    label: 'Resume (PDF)',
    href: url(profile.resume.path),
    path: 'M6 2h8l4 4v16H6V2Zm8 1.5V7h3.5M9 12h6M9 16h6M9 8h2',
  },
  profile.links.github && {
    label: 'GitHub',
    href: profile.links.github,
    external: true,
    fill: true,
    path: 'M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.4-2.2-.2-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.8-4.6 5 .3.3.7 1 .7 2v2.9c0 .3.2.6.7.5A10 10 0 0 0 12 2Z',
  },
  profile.links.linkedin && {
    label: 'LinkedIn',
    href: profile.links.linkedin,
    external: true,
    fill: true,
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.82-2.05 3.75-2.05C20.7 8.65 22 10.9 22 14.1V21h-4v-6.1c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21H9V9Z',
  },
  profile.links.googleScholar && {
    label: 'Google Scholar',
    href: profile.links.googleScholar,
    external: true,
    fill: true,
    path: 'M12 2 1 8.5l11 6.5 9-5.32V17h2V8.5L12 2ZM5 13.18v3.63L12 21l7-4.19v-3.63L12 17.4l-7-4.22Z',
  },
  profile.links.orcid && {
    label: 'ORCID',
    href: profile.links.orcid,
    external: true,
    fill: true,
    path: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM8.2 6.2a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Zm-.9 3.4h1.8v8.2H7.3V9.6Zm3.6 0h3.3c2.6 0 4.2 1.7 4.2 4.1s-1.6 4.1-4.2 4.1h-3.3V9.6Zm1.8 1.6v5h1.4c1.7 0 2.5-1 2.5-2.5s-.8-2.5-2.5-2.5h-1.4Z',
  },
  {
    label: 'Email',
    href: `mailto:${profile.email}`,
    path: 'M3 6.5h18v11H3v-11Zm0 .5 9 6.5 9-6.5',
  },
].filter(Boolean) as Icon[];
---

<ul class="icon-row">
  {
    icons.map((icon) => (
      <li>
        <a
          href={icon.href}
          rel={icon.external ? 'me noopener' : undefined}
          aria-label={icon.label}
          title={icon.label}
        >
          <svg
            viewBox="0 0 24 24"
            fill={icon.fill ? 'currentColor' : 'none'}
            stroke={icon.fill ? 'none' : 'currentColor'}
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={icon.path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
