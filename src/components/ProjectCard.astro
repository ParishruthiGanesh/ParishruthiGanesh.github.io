---
import type { Project } from '../lib/schema.js';
import { PROJECT_STATUS_LABELS } from '../lib/format.js';
import { url } from '../lib/url.js';
import Tag from './Tag.astro';

interface Props {
  project: Project;
  areaLabels: Record<string, string>;
  /** Show the first screenshot as a card thumbnail. */
  showImage?: boolean;
}
const { project, areaLabels, showImage = true } = Astro.props;
const cover = project.screenshots[0];
const href = url(`/projects/${project.id}`);
---
<article
  class="surface-card card-interactive flex flex-col overflow-hidden"
  data-kind={project.kind}
  data-areas={project.researchAreas.join(' ')}
  data-status={project.status}
  data-title={project.name.toLowerCase()}
>
  {
    showImage && cover && (
      <a href={href} class="block overflow-hidden border-b" style="border-color: var(--border)" tabindex="-1" aria-hidden="true">
        <img
          src={url(cover.src)}
          alt=""
          loading="lazy"
          decoding="async"
          class="aspect-[16/9] w-full object-cover object-top"
        />
      </a>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      {project.featured && <Tag tone="ember">Featured</Tag>}
      <Tag tone="outline">{PROJECT_STATUS_LABELS[project.status]}</Tag>
      {
        (project.year || project.period) && (
          <span class="font-mono text-xs" style="color: var(--ink-subtle)">
            {project.period ?? project.year}
          </span>
        )
      }
    </div>

    <h3 class="mt-3 text-lg font-semibold leading-snug">
      <a href={href} class="no-underline transition-colors hover:text-[var(--accent)]" style="color: var(--ink)">
        {project.name}
      </a>
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed" style="color: var(--ink-muted)">{project.tagline}</p>

    {
      project.researchAreas.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {project.researchAreas.map((area) => (
            <Tag tone="accent">{areaLabels[area] ?? area}</Tag>
          ))}
        </div>
      )
    }

    {
      project.technologies.length > 0 && (
        <p class="mt-3 font-mono text-xs leading-relaxed" style="color: var(--ink-subtle)">
          {project.technologies.slice(0, 6).join(' · ')}
          {project.technologies.length > 6 && ` · +${project.technologies.length - 6}`}
        </p>
      )
    }
  </div>
</article>
