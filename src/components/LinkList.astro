---
/**
 * Renders a project's or hackathon's outbound links.
 *
 * A link recorded with `verified: false` gets a small marker rather than being
 * hidden: the URL came from a real source, it just has not been machine-checked.
 * Being explicit about that is more useful than silently presenting it as
 * confirmed.
 */
interface LinkEntry {
  label: string;
  url: string;
  verified: boolean;
}
interface Props {
  links: Partial<Record<string, LinkEntry | undefined>>;
  /** Repository link is suppressed and explained when the repo is private. */
  repositoryPrivate?: boolean;
  size?: 'sm' | 'md';
}
const { links, repositoryPrivate = false, size = 'md' } = Astro.props;

const ICONS: Record<string, string> = {
  repo: 'M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.4-2.2-.2-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.8-4.6 5 .3.3.7 1 .7 2v2.9c0 .3.2.6.7.5A10 10 0 0 0 12 2Z',
  demo: 'M10 14 21 3M21 3h-6M21 3v6M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5',
  devpost: 'M6.2 4h5.3c4.3 0 7 2.9 7 8s-2.7 8-7 8H6.2V4Zm3.4 3v10h1.7c2.4 0 3.8-1.7 3.8-5s-1.4-5-3.8-5H9.6Z',
  video: 'M10 8.5v7l6-3.5-6-3.5ZM3 12a9 9 0 1 1 18 0 9 9 0 0 1-18 0Z',
  paper: 'M14 3v5h5M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5ZM9 13h6M9 17h6',
  docs: 'M4 5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Z',
};
const FILLED = new Set(['repo', 'devpost']);
const entries = Object.entries(links).filter(
  (entry): entry is [string, LinkEntry] => Boolean(entry[1]),
);
const pad = size === 'sm' ? 'px-2.5 py-1 text-xs' : 'px-3 py-1.5 text-sm';
---
{
  (entries.length > 0 || repositoryPrivate) && (
    <ul class="flex flex-wrap items-center gap-2">
      {entries.map(([key, link]) => {
        const isPrivateRepo = key === 'repo' && repositoryPrivate;
        return (
          <li>
            {isPrivateRepo ? (
              <span
                class={`inline-flex items-center gap-1.5 rounded-lg border ${pad}`}
                style="border-color: var(--border); color: var(--ink-subtle); background: var(--surface-sunken)"
                title="This repository is private on GitHub, so it is not linked."
              >
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="4" y="10" width="16" height="10" rx="2" />
                  <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
                Repository is private
              </span>
            ) : (
              <a
                href={link.url}
                rel="noopener"
                class={`inline-flex items-center gap-1.5 rounded-lg border no-underline transition-colors hover:border-[var(--border-strong)] ${pad}`}
                style="border-color: var(--border); color: var(--ink-muted); background: var(--surface-raised)"
              >
                <svg
                  class="h-3.5 w-3.5 shrink-0"
                  viewBox="0 0 24 24"
                  fill={FILLED.has(key) ? 'currentColor' : 'none'}
                  stroke={FILLED.has(key) ? 'none' : 'currentColor'}
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={ICONS[key] ?? ICONS.demo} />
                </svg>
                {link.label}
                {!link.verified && (
                  <span
                    class="ml-0.5 font-mono text-[0.6rem] uppercase tracking-wide"
                    style="color: var(--ink-subtle)"
                    title="Supplied by hand and not yet machine-verified"
                  >
                    unverified
                  </span>
                )}
              </a>
            )}
          </li>
        );
      })}
    </ul>
  )
}
