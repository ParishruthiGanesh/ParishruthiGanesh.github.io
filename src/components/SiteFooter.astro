---
import { loadContent } from '../lib/content.js';
import { NAV_ITEMS } from '../lib/nav.js';
import { url } from '../lib/url.js';
import { splitEmail } from '../lib/format.js';

const { profile, syncedAt } = loadContent();
const { user, domain } = splitEmail(profile.email);
const year = new Date().getFullYear();

const external = [
  profile.links.github && { label: 'GitHub', href: profile.links.github },
  profile.links.googleScholar && { label: 'Google Scholar', href: profile.links.googleScholar },
  profile.links.linkedin && { label: 'LinkedIn', href: profile.links.linkedin },
  profile.links.orcid && { label: 'ORCID', href: profile.links.orcid },
].filter((item): item is { label: string; href: string } => Boolean(item));
---

<footer class="mt-24 border-t" style="border-color: var(--border); background: var(--surface-sunken)">
  <div class="container-page py-12">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <p class="font-serif text-lg font-semibold" style="color: var(--ink)">{profile.name}</p>
        <p class="mt-1 text-sm" style="color: var(--ink-muted)">
          {profile.role} · {profile.affiliation}
        </p>
        <p class="mt-4 max-w-sm text-sm" style="color: var(--ink-subtle)">
          {profile.shortBio}
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="eyebrow">Pages</h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm md:grid-cols-1">
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a href={url(item.href)} class="link-underline no-underline" style="color: var(--ink-muted)">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow">Elsewhere</h2>
        <ul class="mt-3 space-y-1.5 text-sm">
          {
            external.map((item) => (
              <li>
                <a
                  href={item.href}
                  rel="me noopener"
                  class="link-underline no-underline"
                  style="color: var(--ink-muted)"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${user}@${domain}`}
              class="link-underline no-underline"
              style="color: var(--ink-muted)">Email</a
            >
          </li>
          <li>
            <a
              href={url(profile.resume.path)}
              class="link-underline no-underline"
              style="color: var(--ink-muted)">Resume (PDF)</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t pt-6 text-xs sm:flex-row sm:items-center sm:justify-between"
      style="border-color: var(--border); color: var(--ink-subtle)"
    >
      <p>© {year} {profile.name}. Built with Astro; content validated at build time.</p>
      <p>
        {
          syncedAt ? (
            <>
              Repository data synchronised{' '}
              <time datetime={syncedAt}>{syncedAt.slice(0, 10)}</time>
            </>
          ) : (
            'Repository data not yet synchronised'
          )
        }
        {' · '}
        <a href={url('/rss.xml')} class="link-underline no-underline" style="color: inherit">RSS</a>
      </p>
    </div>
  </div>
</footer>
